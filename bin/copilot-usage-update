#!/bin/bash

# copilot-usage-update: run the collector and publish its record.
#
# The Agents panel (omarchy.agents) draws whatever JSON records appear in its
# usage directory — the filename is the agent id, there is no allowlist, and
# it rescans after every refresh. So publishing one record there is the whole
# integration: Copilot gains a tab next to Claude and Codex.
#
# omarchy-agent-usage-update only globs $OMARCHY_PATH/bin/omarchy-agent-usage-*,
# so it will never run this collector — and equally never delete a record it
# did not write. Scheduling is therefore ours, which is what Service.qml is
# for. This script is the same thing by hand.
#
#   copilot-usage-update              # publish
#   copilot-usage-update --force      # ignore the scan cache
#   copilot-usage-update --stdout     # print the record, publish nothing

set -uo pipefail

AGENT_ID="copilot"
USAGE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/omarchy/agents/usage"
COLLECTOR="$(dirname "$(readlink -f "$0")")/copilot-usage"

flags=()
to_stdout=0
for arg in "$@"; do
  case "$arg" in
  --force | --limits-only) flags+=("$arg") ;;
  --stdout) to_stdout=1 ;;
  -h | --help)
    sed -n '3,18p' "$0" | sed 's/^# \{0,1\}//'
    exit 0
    ;;
  *)
    echo "copilot-usage-update: unknown option $arg" >&2
    exit 2
    ;;
  esac
done

[[ -x $COLLECTOR ]] || {
  echo "copilot-usage-update: collector not found at $COLLECTOR" >&2
  exit 1
}

# A collector that fails or prints garbage must leave the previous record
# alone: a stale tab beats a tab that vanishes and comes back.
if ! record=$("$COLLECTOR" "${flags[@]}") || [[ -z $record ]] || ! jq -e . >/dev/null 2>&1 <<<"$record"; then
  echo "copilot-usage-update: collector failed" >&2
  exit 1
fi

if (( to_stdout )); then
  printf '%s\n' "$record"
  exit 0
fi

mkdir -p "$USAGE_DIR" || exit 1

# Temp file plus rename, the way omarchy-agent-usage-update does it: the
# panel watches this path, and a reader must never catch a half-written
# record. The temp name is unique to this writer so two concurrent runs do
# not fight over one scratch file.
tmp=$(mktemp "$USAGE_DIR/.$AGENT_ID.XXXXXX") || exit 1
printf '%s\n' "$record" >"$tmp" && mv "$tmp" "$USAGE_DIR/$AGENT_ID.json" || {
  rm -f "$tmp"
  exit 1
}
